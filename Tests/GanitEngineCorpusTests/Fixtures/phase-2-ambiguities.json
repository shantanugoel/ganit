{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "in: terminal alias after a number is inches",
      "expression": "12 in",
      "expected": {
        "status": "value",
        "display": "12 in",
        "fullPrecision": "12 in",
        "approximate": false
      }
    },
    {
      "name": "in: attached alias is inches",
      "expression": "12in",
      "expected": {
        "status": "value",
        "display": "12 in",
        "fullPrecision": "12 in",
        "approximate": false
      }
    },
    {
      "name": "in: keyword after a quantity converts",
      "expression": "12 km in miles",
      "expected": {
        "status": "value",
        "display": "31,250/4,191 mi",
        "fullPrecision": "31250/4191 mi",
        "approximate": false
      }
    },
    {
      "name": "in: inch quantity followed by conversion keyword",
      "expression": "12 in in cm",
      "expected": {
        "status": "value",
        "display": "762/25 cm",
        "fullPrecision": "762/25 cm",
        "approximate": false
      }
    },
    {
      "name": "in: conversion target may be the inch alias",
      "expression": "1 ft in in",
      "expected": {
        "status": "value",
        "display": "12 in",
        "fullPrecision": "12 in",
        "approximate": false
      }
    },
    {
      "name": "in: inch alias accepts a unit power",
      "expression": "12 in^2",
      "expected": {
        "status": "value",
        "display": "12 in^2",
        "fullPrecision": "12 in^2",
        "approximate": false
      }
    },
    {
      "name": "in: keyword after a grouped quantity is an incomplete conversion",
      "expression": "(1 m + 2 m) in",
      "expected": {
        "status": "syntaxFailure",
        "code": "expectedConversionUnit",
        "messageKey": "syntax.expectedConversionUnit",
        "message": "Enter a unit to convert to.",
        "lowerBound": 12,
        "upperBound": 14
      }
    },
    {
      "name": "in: keyword after a computed quantity is an incomplete conversion",
      "expression": "(1 m * 2) in",
      "expected": {
        "status": "syntaxFailure",
        "code": "expectedConversionUnit",
        "messageKey": "syntax.expectedConversionUnit",
        "message": "Enter a unit to convert to.",
        "lowerBound": 10,
        "upperBound": 12
      }
    },
    {
      "name": "in: inch alias then a bare unit is not a conversion",
      "expression": "1 m + 2 in cm",
      "expected": {
        "status": "syntaxFailure",
        "code": "unexpectedToken",
        "messageKey": "syntax.unexpectedToken",
        "message": "This part of the expression is unexpected.",
        "lowerBound": 11,
        "upperBound": 13
      }
    },
    {
      "name": "in: bare number cannot be converted",
      "expression": "5 in miles",
      "expected": {
        "status": "syntaxFailure",
        "code": "unexpectedToken",
        "messageKey": "syntax.unexpectedToken",
        "message": "This part of the expression is unexpected.",
        "lowerBound": 5,
        "upperBound": 10
      }
    },
    {
      "name": "in: exponent never takes the inch alias",
      "expression": "(3 m)^2 in cm^2",
      "expected": {
        "status": "value",
        "display": "90,000 cm^2",
        "fullPrecision": "90000 cm^2",
        "approximate": false
      }
    },
    {
      "name": "in: in after a computed number is not inches",
      "expression": "2^3 in",
      "expected": {
        "status": "syntaxFailure",
        "code": "unexpectedToken",
        "messageKey": "syntax.unexpectedToken",
        "message": "This part of the expression is unexpected.",
        "lowerBound": 4,
        "upperBound": 6
      }
    },
    {
      "name": "in: prose around in is not ignored",
      "expression": "price in dollars",
      "expected": {
        "status": "syntaxFailure",
        "code": "unexpectedToken",
        "messageKey": "syntax.unexpectedToken",
        "message": "This part of the expression is unexpected.",
        "lowerBound": 6,
        "upperBound": 8
      }
    },
    {
