{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "future value compounds a plain number",
      "expression": "fv(1000, 10%, 2)",
      "expected": {
        "status": "value",
        "display": "1,210",
        "fullPrecision": "1210",
        "approximate": false
      }
    },
    {
      "name": "future value keeps the currency and flags the rounding",
      "expression": "fv(10000 USD, 5%, 10)",
      "expected": {
        "status": "value",
        "display": "\u2248 $16,288.95",
        "fullPrecision": "16679880978201/1024000000 USD",
        "approximate": true
      }
    },
    {
      "name": "present value undoes the compounding",
      "expression": "pv(1210, 10%, 2)",
      "expected": {
        "status": "value",
        "display": "1,000",
        "fullPrecision": "1000",
        "approximate": false
      }
    },
    {
      "name": "present value discounts money twelve periods out",
      "expression": "pv(1000 USD, 0.5%, 12)",
      "expected": {
        "status": "value",
        "display": "\u2248 $941.91",
        "fullPrecision": "4096000000000000000000000000000/4348632317396990233762642401 USD",
        "approximate": true
      }
    },
    {
      "name": "a thirty-year mortgage payment rounds to cents",
      "expression": "pmt(300000 USD, 0.5%, 360)",
      "expected": {
        "status": "value",
        "display": "\u2248 $1,798.65",
        "fullPrecision": " USD",
        "approximate": true
      }
    },
    {
      "name": "a zero rate splits the amount evenly",
      "expression": "pmt(1200, 0%, 12)",
      "expected": {
        "status": "value",
        "display": "100",
        "fullPrecision": "100",
        "approximate": false
      }
    },
    {
      "name": "a monthly rate comes from dividing the annual one",
      "expression": "fv(1000, 6% / 12, 24)",
      "expected": {
        "status": "value",
        "display": "≈ 1,127.15977620539",
        "fullPrecision": "18910603031909517609304823750309063692518962297803044801/16777216000000000000000000000000000000000000000000000",
        "approximate": false
      }
    },
    {
      "name": "a fractional period has no meaning",
      "expression": "fv(1000, 5%, 1.5)",
      "expected": {
        "status": "evaluationFailure",
        "code": "evaluation.invalidDomain",
        "messageKey": "error.evaluation.invalidDomain",
        "message": "This operation is not defined for the given value.",
        "lowerBound": 13,
        "upperBound": 16
      }
    },
    {
      "name": "a length is not an amount",
      "expression": "fv(1 m, 5%, 2)",
      "expected": {
        "status": "evaluationFailure",
        "code": "evaluation.typeMismatch",
        "messageKey": "error.evaluation.typeMismatch",
        "message": "This operation cannot combine these value types.",
        "lowerBound": 3,
        "upperBound": 6
      }
    },
    {
      "name": "every argument is required",
      "expression": "fv(1000, 5%)",
      "expected": {
        "status": "evaluationFailure",
        "code": "evaluation.argumentCountMismatch",
        "messageKey": "error.evaluation.argumentCountMismatch",
        "message": "The function received the wrong number of arguments.",
        "lowerBound": 0,
        "upperBound": 2
      }
    }
  ]
}
