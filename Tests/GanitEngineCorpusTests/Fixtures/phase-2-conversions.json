      "expected": {
        "status": "value",
        "display": "3,262/25 cm",
        "fullPrecision": "3262/25 cm",
        "approximate": false
      }
    },
    {
      "name": "affine conversion",
      "expression": "0 °C as °F",
      "expected": {
        "status": "value",
        "display": "32 °F",
        "fullPrecision": "32 °F",
        "approximate": false
      }
    },
    {
      "name": "compound prefixed quantity",
      "expression": "75 MB/s",
      "expected": {
        "status": "value",
        "display": "75 MB/s",
        "fullPrecision": "75 MB/s",
        "approximate": false
      }
    },
    {
      "name": "incompatible conversion",
      "expression": "1 m to s",
      "expected": {
        "status": "evaluationFailure",
